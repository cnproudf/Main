# -----------------------------------------------------------------------------
# EXAMPLE environment file  (safe to commit -- contains NO real values)
#
# How to use this:
#   1. Make a COPY of this file in the same folder named exactly:  .env.local
#   2. Paste your real Supabase values into the copy.
#   3. Never rename the copy and never commit it -- .gitignore already blocks it.
#
# Where each value comes from in the Supabase dashboard is written next to it.
# -----------------------------------------------------------------------------

# Your project's web address.
# Dashboard: Settings (gear icon, bottom-left) -> "API"  (or "Data API")
#   -> copy the "Project URL". It looks like https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# The PUBLIC key. This one is DESIGNED to be seen by web browsers, so it is not
# a deep secret -- but we still keep it here out of good habit.
# Dashboard: Settings -> "API" -> "Project API keys" -> copy the "anon" / "public"
#   key. (Newer dashboards call this the "publishable" key under "API Keys".)
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-public-key-here

# NOTE: Do NOT put your "service_role" / "secret" key or your database password
# in this sandbox. We do not need them, and they are the truly dangerous ones.
